# CollegeFootballData.com API key (https://collegefootballdata.com/key)
# Pro / 75k monthly calls is enough for a full 2016–2026 ingest with week-level stats.
CFBD_API_KEY=

# Train/collect/retrain jobs only. The API/serve process must leave this unset
# so /api/teams, /api/predictions, matchups, and logos never hit CFBD.
# CFBD_ALLOW_CALLS=1

